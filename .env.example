# ============================================================
# EXCEL STORE - ENVIRONMENT VARIABLES EXAMPLE
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ============================================================

# Supabase (Frontend — public anon key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Identity
VITE_APP_NAME=Excel Store
VITE_SITE_URL=https://your-site.com

# Feature Flags
VITE_ENABLE_MANUAL_PAYMENTS=true

# ============================================================
# SERVER / EDGE FUNCTIONS (Never expose these in frontend)
# ============================================================

# Supabase Service Role (server-side only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Provider
EMAIL_PROVIDER_API_KEY=your-email-api-key

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
